# Copy to ".env.drizzle" (gitignored). Used only by Drizzle Kit on your dev machine.
# Supabase dashboard -> Connect -> "Session pooler" (or Direct connection) URI.
# This contains your database password: never put it in ".env" (that file ships inside the app).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
